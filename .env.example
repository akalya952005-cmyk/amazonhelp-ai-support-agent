# Anthropic API Key for Claude reply generation and LLM-as-a-judge evaluation
# If left unset or set to 'mock', the system runs in high-fidelity deterministic simulation mode.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model configuration
ANTHROPIC_MODEL=claude-3-haiku-20240307
# Alternative high-power model: claude-3-5-sonnet-20241022

# Confidence threshold below which intent classifications are flagged as low confidence
CONFIDENCE_THRESHOLD=0.55
